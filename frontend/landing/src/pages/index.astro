---
import Layout from "../layouts/Layout.astro";

const PHONE = "+385 91 505 8719";
const PHONE_HREF = "tel:+385915058719";
const EMAIL = "vmracunala@vmracunala.hr";
const EMAIL_HREF = `mailto:${EMAIL}`;
const WORK_HOURS = "8–16";
const YEAR = new Date().getFullYear();

const mapsUrl = (address: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

const nav = [
  { href: "#usluge", label: "Usluge" },
  { href: "#postupak", label: "Kako radimo" },
  { href: "#lokacija", label: "Lokacija" },
  { href: "#kontakt", label: "Kontakt" },
];

const contactRows = [
  { label: "Telefon", value: PHONE, href: PHONE_HREF },
  { label: "E-mail", value: EMAIL, href: EMAIL_HREF },
  { label: "Prodajno mjesto", value: "Velebitska ulica 71, Split" },
  { label: "Adresa", value: "Vukovarska ulica 127, Split" },
  { label: "Radno vrijeme", value: WORK_HOURS },
];

// Icon paths are 24×24 stroke outlines.
const services = [
  {
    title: "Dijagnostika i popravak",
    text: "Računalo se ne pali, pregrijava se, usporava ili javlja greške? Pronalazimo uzrok i popravljamo kvar na laptopima i stolnim računalima.",
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"/>',
  },
  {
    title: "Nadogradnja",
    text: "Novi SSD, više radne memorije ili jača grafička kartica često starijem računalu vrate brzinu za dio cijene novog.",
    icon: '<rect x="5" y="5" width="14" height="14" rx="1.5"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  },
  {
    title: "Sustav i programi",
    text: "Instalacija i reinstalacija operativnog sustava, upravljačkih programa i aplikacija koje svakodnevno koristite.",
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4M7 8l3 3-3 3M13 14h4"/>',
  },
  {
    title: "Čišćenje i održavanje",
    text: "Čišćenje prašine, zamjena termalne paste i provjera ventilatora za tiše i hladnije računalo.",
    icon: '<circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="1.6"/><path d="M12 10.4c0-3 1-5.6 3.5-5.6M13.6 12c3 0 5.6 1 5.6 3.5M12 13.6c0 3-1 5.6-3.5 5.6M10.4 12c-3 0-5.6-1-5.6-3.5"/>',
  },
  {
    title: "Poslovna IT rješenja",
    text: "Opremanje i održavanje radnih stanica, mreže i opreme za urede i tvrtke.",
    icon: '<rect x="9" y="2" width="6" height="5" rx="1"/><rect x="2" y="17" width="6" height="5" rx="1"/><rect x="16" y="17" width="6" height="5" rx="1"/><path d="M12 7v5M5 17v-2.5a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1V17M12 12v1.5"/>',
  },
  {
    title: "Prodaja opreme",
    text: "Računala, komponente i oprema popularnih brendova na našem prodajnom mjestu u Velebitskoj ulici.",
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/>',
  },
];

const steps = [
  { title: "Javite se", text: "Nazovite ili pošaljite e-mail i ukratko opišite problem." },
  { title: "Donesite uređaj", text: "Uređaj donesite na prodajno mjesto u Velebitskoj ulici 71." },
  {
    title: "Dijagnostika",
    text: "Pregledamo uređaj i javimo vam što treba napraviti prije nego što krenemo s popravkom.",
  },
  { title: "Preuzimanje", text: "Kad je posao gotov, javimo vam da možete preuzeti uređaj." },
];

const locations = [
  {
    badge: "Prodajno mjesto",
    street: "Velebitska ulica 71",
    primary: true,
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    badge: "Adresa tvrtke",
    street: "Vukovarska ulica 127",
    primary: false,
    icon: '<rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01"/>',
  },
];

const phoneIcon =
  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>';
const mailIcon = '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>';
const arrowRight = '<path d="M5 12h14M13 6l6 6-6 6"/>';
const arrowUpRight = '<path d="M7 17 17 7M8 7h9v9"/>';
const logoM = "M30 70 L30 32 L40 32 L50 50 L60 32 L70 32 L70 70 L61 70 L61 48 L50 66 L39 48 L39 70 Z";
---

<Layout>
  <header class="site-header">
    <div class="container site-header__inner">
      <a href="#vrh" class="brand">
        <svg width="40" height="40" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="logo-outer" cx="50" cy="50" r="48"></circle>
          <circle class="logo-inner" cx="50" cy="50" r="34"></circle>
          <path class="logo-m" d={logoM}></path>
        </svg>
        <span class="brand__name">VM računala</span>
      </a>
      <nav class="nav" aria-label="Glavna navigacija">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Promijeni temu">
          <svg class="icon icon-sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="icon icon-moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
        <a class="btn btn--solid btn--sm" href={PHONE_HREF} aria-label={`Nazovite ${PHONE}`}>
          <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={phoneIcon} />
          <span class="btn__label">Nazovite</span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section id="vrh" class="hero">
      <div class="container hero__inner">
        <div class="hero__eyebrow mono">
          <span class="dot"></span>
          <span>Poslovna rješenja za IT</span>
          <span aria-hidden="true">/</span>
          <span>Split, Hrvatska</span>
        </div>

        <h1 class="hero__title">
          Servis računala <span class="highlight">u Splitu.</span>
        </h1>

        <div class="hero__grid">
          <div class="hero__copy">
            <p class="hero__lead">
              Popravak, nadogradnja i održavanje laptopa i stolnih računala, te IT podrška za tvrtke. Sve na
              jednom mjestu, u Splitu.
            </p>
            <div class="hero__ctas">
              <a class="btn btn--solid" href={PHONE_HREF}>
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" set:html={phoneIcon} />
                {PHONE}
              </a>
              <a class="btn btn--outline" href={EMAIL_HREF}>
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" set:html={mailIcon} />
                Pošaljite upit
              </a>
            </div>
          </div>

          <div class="tag">
            <svg
              class="tag__seal"
              width="150"
              height="150"
              viewBox="0 0 200 200"
              role="img"
              aria-label="VM računala d.o.o. — 21 000 Split, Hrvatska"
            >
              <circle class="seal-outer" cx="100" cy="100" r="98"></circle>
              <circle class="seal-inner" cx="100" cy="100" r="64"></circle>
              <defs>
                <path id="vmRingPath" d="M100 100 m-80 0 a80 80 0 1 1 160 0 a80 80 0 1 1 -160 0"></path>
              </defs>
              <g class="seal-ring">
                <text class="seal-text" font-family="'IBM Plex Mono', monospace" font-size="15" font-weight="500" letter-spacing="3.2">
                  <textPath href="#vmRingPath">VM RAČUNALA D.O.O. • 21 000 SPLIT • HRVATSKA • </textPath>
                </text>
              </g>
              <path class="seal-m" d="M62 132 L62 68 L80 68 L100 100 L120 68 L138 68 L138 132 L122 132 L122 96 L100 128 L78 96 L78 132 Z"></path>
            </svg>
            <div class="tag__card">
              <div class="tag__header">Servisni karton</div>
              <dl class="tag__list">
                {
                  contactRows.map((row) => (
                    <div class="tag__row">
                      <dt>{row.label}</dt>
                      <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="usluge" class="services">
      <div class="container section">
        <div class="services__head">
          <div class="section-head">
            <span class="mono">01 — Usluge</span>
            <h2 class="h2" style="max-width: 12em">Od kvara do nadogradnje.</h2>
          </div>
          <p class="services__intro">
            Bilo da je riječ o jednom laptopu ili cijelom uredu, javite nam se i reći ćemo vam što se može napraviti.
          </p>
        </div>

        <div class="services__grid">
          {
            services.map((service, i) => (
              <article class="service">
                <div class="service__top">
                  <svg class="icon icon--thin" width="36" height="36" viewBox="0 0 24 24" aria-hidden="true" set:html={service.icon} />
                  <span class="service__num">{String(i + 1).padStart(2, "0")}</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="postupak" class="process">
      <div class="container section">
        <div class="section-head">
          <span class="mono">02 — Kako radimo</span>
          <h2 class="h2" style="max-width: 14em">Četiri koraka do ispravnog računala.</h2>
        </div>
        <ol class="steps">
          {
            steps.map((step, i) => (
              <li class="step">
                <div class="step__marker">
                  <span class="step__num">{i + 1}</span>
                  {i < steps.length - 1 && <span class="step__rule" aria-hidden="true" />}
                </div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- LOCATIONS -->
    <section id="lokacija" class="locations invert">
      <div class="container section">
        <div class="section-head">
          <span class="mono">03 — Lokacija</span>
          <h2 class="h2">Gdje nas naći.</h2>
        </div>
        <div class="locations__grid">
          {
            locations.map((loc) => (
              <div class:list={["location", { "location--primary": loc.primary }]}>
                <div class="location__top">
                  <span class="location__badge mono">{loc.badge}</span>
                  <svg class="icon icon--thin" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" set:html={loc.icon} />
                </div>
                <p class="location__address">
                  {loc.street}
                  <br />
                  21000 Split
                </p>
                <a class="location__link" href={mapsUrl(`${loc.street}, 21000 Split`)} target="_blank" rel="noopener">
                  Otvori u kartama
                  <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowUpRight} />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT CTA -->
    <section id="kontakt" class="contact on-accent">
      <div class="container contact__inner">
        <div class="contact__copy">
          <span class="mono">04 — Kontakt</span>
          <h2 class="contact__title">Javite se.</h2>
          <p class="contact__text">Opišite problem telefonom ili e-mailom i dogovorit ćemo sljedeći korak.</p>
        </div>
        <div class="contact__actions">
          <a class="btn btn--solid" href={PHONE_HREF}>
            <span>{PHONE}</span>
            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowRight} />
          </a>
          <a class="btn btn--outline" href={EMAIL_HREF}>
            <span>{EMAIL}</span>
            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" set:html={arrowRight} />
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      <div class="site-footer__brand">
        <svg width="32" height="32" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="logo-outer" cx="50" cy="50" r="48"></circle>
          <circle class="logo-inner" cx="50" cy="50" r="34"></circle>
          <path class="logo-m" d={logoM}></path>
        </svg>
        <span>© {YEAR} VM računala d.o.o. · 21000 Split, Hrvatska</span>
      </div>
      <span class="mono">Izrada: Jan Modun</span>
    </div>
  </footer>
</Layout>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const apply = (theme: "light" | "dark") => {
    root.dataset.theme = theme;
    if (themeColor) themeColor.content = theme === "dark" ? "#121314" : "#F2F0EB";
    toggle?.setAttribute("aria-label", theme === "dark" ? "Uključi svijetlu temu" : "Uključi tamnu temu");
  };

  apply(root.dataset.theme === "light" ? "light" : "dark");

  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    apply(next);
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
